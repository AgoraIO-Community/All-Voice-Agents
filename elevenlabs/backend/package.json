{
  "name": "@voice-agents/elevenlabs-backend",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "predev": "npm run build --workspace @repo/elevenlabs-server",
    "dev": "tsc && node dist/index.js",
    "prebuild": "npm run build --workspace @repo/elevenlabs-server",
    "build": "tsc",
    "precheck-types": "npm run build --workspace @repo/elevenlabs-server",
    "start": "node dist/index.js",
    "lint": "eslint . --max-warnings 0",
    "check-types": "tsc --noEmit"
  },
  "devDependencies": {
    "@repo/eslint-config": "*",
    "@repo/typescript-config": "*",
    "@types/node": "^22.15.3",
    "eslint": "^9.39.1",
    "typescript": "5.9.2"
  },
  "dependencies": {
    "@repo/elevenlabs-server": "*",
    "dotenv": "^17.4.2"
  }
}

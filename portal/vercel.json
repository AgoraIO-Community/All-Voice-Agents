{
  "redirects": [
    {
      "source": "/livekit",
      "destination": "https://livekit-voiceagent.vercel.app/",
      "permanent": false
    },
    {
      "source": "/livekit/:path*",
      "destination": "https://livekit-voiceagent.vercel.app/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
